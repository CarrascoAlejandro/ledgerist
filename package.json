{
  "name": "ledgerist",
  "version": "0.1.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "desktop": "npm run dev -w @ledger/desktop",
    "build:desktop": "npm run build -w @ledger/desktop",
    "mobile:sync": "npm run sync -w @ledger/mobile",
    "mobile:android": "npm run android -w @ledger/mobile",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/database --noEmit && tsc -p packages/stores --noEmit && tsc -p packages/sync --noEmit && tsc -p apps/web --noEmit && tsc -p apps/desktop --noEmit && tsc -p apps/mobile --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sharp": "^0.35.4",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "projects": [
      "<rootDir>/packages/shared",
      "<rootDir>/packages/database",
      "<rootDir>/packages/stores",
      "<rootDir>/packages/sync",
      "<rootDir>/apps/web"
    ]
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
