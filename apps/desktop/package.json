{
  "name": "@ledger/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Ledgerist — local-first personal ledger app (desktop)",
  "author": "Alejandro Carrasco <carrascoalejandro2003@gmail.com>",
  "homepage": "https://github.com/CarrascoAlejandro/ledgerist",
  "main": "dist/main.js",
  "scripts": {
    "build:web": "npm run build -w @ledger/web",
    "build:ts": "esbuild src/main.ts --bundle --platform=node --external:electron --external:better-sqlite3 --external:sql.js --external:ws --external:bufferutil --external:utf-8-validate --outdir=dist --format=cjs --sourcemap && esbuild src/preload.ts --bundle --platform=node --external:electron --outdir=dist --format=cjs --sourcemap",
    "build": "npm run build:web && npm run build:ts && electron-builder",
    "start": "electron dist/main.js",
    "dev": "npm run build:web && npm run build:ts && electron dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/ws": "^8.5.12",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.ledgerist.desktop",
    "productName": "Ledgerist",
    "executableName": "ledgerist-desktop",
    "electronVersion": "31.7.7",
    "artifactName": "${productName}_${version}_${arch}.${ext}",
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web-dist"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office"
    },
    "deb": {
      "packageName": "ledgerist-desktop"
    }
  },
  "license": "GPL-3.0-or-later"
}
