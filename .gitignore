# Dependencies
node_modules/
.npm

# Build outputs
dist/
build/
*.tsbuildinfo

# ...but electron-builder's icon source lives in a conventionally-named build/
# dir. Git cannot re-include a file under an excluded directory, so the
# directory itself has to be unignored.
!apps/desktop/build/

# Test coverage
coverage/

# Environment files
.env
.env.local
.env.*.local

# Database files
*.db
*.sqlite
*.sqlite3

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Capacitor native dirs
ios/
android/
electron/

# Vite
.vite/
dist-electron/

