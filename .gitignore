# Dependencies
node_modules/
.npm

# Build outputs
dist/
build/
*.tsbuildinfo

# ...but electron-builder's icon source lives in a conventionally-named build/
# dir. Git cannot re-include a file under an excluded directory, so the
# directory itself has to be unignored.
!apps/desktop/build/

# Test coverage
coverage/

# Environment files
.env
.env.local
.env.*.local

# Database files
*.db
*.sqlite
*.sqlite3

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Capacitor native dirs
ios/
android/
electron/

# Vite
.vite/
dist-electron/

# Android release signing (keep the keystore backed up outside git!)
*.keystore
keystore.properties

# Local maintainer notes — working records, not user documentation
notes/

# Agent skills and local agent settings — for every agent, not just one.
# These are routinely synced in from private or employer repositories, so they
# must never be tracked here: committing them would publish internal tooling
# and the names of private repos. Keep the files locally, just never staged.
.agents/
skills-lock.json
.claude/settings.local.json
.claude/skills/
.cursor/rules/
.windsurf/rules/
.aider*
AGENTS.local.md
